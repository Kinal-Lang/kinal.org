}

[IO.Web.Route("/api/run", IO.Web.HttpMethod.POST)] Static Function void HandleRunCodeRequest(IO.Web.Context context)
{
    If (context.Request.ContentLength > MaxCodeSizeBytes)
    {
        context.Response.Text("Code payload exceeds 4 KB.", 413);
        Return;
    }

    string code = context.Request.BodyText();
    If (code == null || code == "")
    {
        context.Response.Text("No source code submitted.", 400);
        Return;
    }

    If (code.Length() > MaxCodeSizeBytes)
    {
        context.Response.Text("Code payload exceeds 4 KB.", 413);
        Return;
    }

    Try
    {
        Sandbox sandbox = New Sandbox(code);
        string job_id = NextJobId();
        sandbox.StartJob(job_id);
        context.Response.Text(job_id, 202);
    }
    Catch (IO.Error e)
    {
        context.Response.Text(e.Title, 400);
    }
}

[IO.Web.Route("/api/run/status")] Static Function void HandleRunCodeStatusRequest(IO.Web.Context context)
{
    string job_id = context.Request.QueryValue("id");
    string status;
    string result;

    If (job_id == null || job_id == "")
    {
        context.Response.Text("unknown\nMissing job id.", 400);
        Return;
    }

    status = ReadJobStatus(job_id);
    If (status == "")
    {
        If (IO.Directory.Exists(Sandbox.JobPath(job_id)))
        {
            context.Response.Text("queued", 202);
            Return;
        }

        If (IO.File.Exists(Sandbox.JobResultPath(job_id)))
        {
            status = "completed";
        }
        Else
        {
            context.Response.Text("unknown\nJob not found.", 404);
            Return;
        }
    }

    If (status == "queued" || status == "compiling" || status == "running")
    {
        context.Response.Text(status, 202);
        Return;
    }

    result = IO.File.ReadIfExists(Sandbox.JobResultPath(job_id));
    If (result == null)
    {
        result = "";
    }

    If (status == "completed")
    {
        context.Response.Text(BuildJobResponse(status, result));
        Sandbox.CleanupJob(job_id);
        Return;
    }

    If (status == "rejected")
    {
        context.Response.Text(BuildJobResponse(status, result), 400);
        Sandbox.CleanupJob(job_id);
        Return;
    }

    context.Response.Text(BuildJobResponse(status, result), 500);
    Sandbox.CleanupJob(job_id);
}

Trusted Static Function IO.Web.Server BuildServer(int port = 18081, string host = "0.0.0.0")
{
    IO.Web.Server server = New IO.Web.Server(port, host);
    server.MaxRequestBytes = MaxCodeSizeBytes;
    server.UseStatic("/static", WebsitePaths.ManagedStaticPath()).RefreshRoutes().UseRoutes();
    Return server;
}
