Unit Kinal.Website;

Get IO.File;
Get IO.Text;
Get IO.Web;
Get IO.Error;
Get IO.Directory;
Get IO.Time;

int MaxCodeSizeBytes = 4096;
string cachedIndexPageHtml = null;
string cachedIndexPageZhHtml = null;
string cachedHeroCodeHtml = null;
string cachedInitialSampleHtml = null;

Trusted Static Function string EscapeHtmlText(string text)
{
    string value = text;
    If (value == null)
    {
        Return "";
    }

    value = IO.Text.Replace(value, "&", "&amp;");
    value = IO.Text.Replace(value, "<", "&lt;");
    value = IO.Text.Replace(value, ">", "&gt;");
    Return value;
}

Trusted Static Function string NextJobId()
{
    string job_id = "";
    For (int i = 0; i < 64; i++)
    {
        job_id = [f]"{[string](IO.Time.GetNanoTick())}_{WebsiteRuntime.RandomString(8)}";
        If (!IO.Directory.Exists(Sandbox.JobPath(job_id)))
        {
            Return job_id;
        }
    }
    Throw New IO.Error("Unable to allocate sandbox job id", "Kinal.Website");
}

Trusted Static Function string ReadJobStatus(string job_id)
{
    string status_path = Sandbox.JobStatusPath(job_id);
    If (!IO.File.Exists(status_path))
    {
        Return "";
    }
    Return IO.Text.Trim(IO.File.ReadAllText(status_path));
}

Trusted Static Function string BuildJobResponse(string status, string payload)
{
    If (payload == null || payload == "")
    {
        Return status;
    }
    Return [f]"{status}\n{payload}";
}

Trusted Static Function string HeroCodeHtml()
{
    If (cachedHeroCodeHtml != null)
    {
        Return cachedHeroCodeHtml;
    }

    cachedHeroCodeHtml = EscapeHtmlText(IO.File.ReadAllText(WebsitePaths.JoinPath(WebsitePaths.ManagedContentPath(), "hero.kn")));
    Return cachedHeroCodeHtml;
}

Trusted Static Function string InitialSampleHtml()
{
    If (cachedInitialSampleHtml != null)
    {
        Return cachedInitialSampleHtml;
    }

    cachedInitialSampleHtml = EscapeHtmlText(IO.File.ReadAllText(WebsitePaths.JoinPath(WebsitePaths.ManagedContentPath(), "block.kn")));
    Return cachedInitialSampleHtml;
}

Trusted Static Function string RenderPageHtml(string file_path)
{
    string html = IO.File.ReadAllText(file_path);
    html = IO.Text.Replace(html, "{{KINAL_HERO_CODE}}", HeroCodeHtml());
    html = IO.Text.Replace(html, "{{KINAL_INITIAL_SAMPLE_CODE}}", InitialSampleHtml());
    Return html;
}

Trusted Static Function string ResolvePageHtml(string file_path)
{
    string index_page = WebsitePaths.JoinPath(WebsitePaths.ManagedHtmlPath(), "index.html");
    string zh_page = WebsitePaths.JoinPath3(WebsitePaths.ManagedHtmlPath(), "zh-CN", "index.html");

    If (file_path == index_page)
    {
        If (cachedIndexPageHtml == null)
        {
            cachedIndexPageHtml = RenderPageHtml(file_path);
        }
        Return cachedIndexPageHtml;
    }

    If (file_path == zh_page)
    {
        If (cachedIndexPageZhHtml == null)
        {
            cachedIndexPageZhHtml = RenderPageHtml(file_path);
        }
        Return cachedIndexPageZhHtml;
    }

    Return RenderPageHtml(file_path);
}

Trusted Static Function void ServePage(IO.Web.Context context, string file_path)
{
    context.Response.Html(ResolvePageHtml(file_path));
}

Trusted Static Function void ServeManagedPage(IO.Web.Context context, string html_relative_path)
{
    ServePage(context, WebsitePaths.ManagedHtmlFilePath(html_relative_path));
}

[IO.Web.Route("/")] Static Function void ServeHomePage(IO.Web.Context context)
{
    ServeManagedPage(context, "index.html");
}

